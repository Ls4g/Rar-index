{
  "crons": [
    {
      "path": "/api/cron/ebay-scout",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/portfolio-snapshots",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/cron/rar-agents",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/agent-reliability",
      "schedule": "30 11 * * *"
    },
    {
      "path": "/api/cron/listing-outcomes",
      "schedule": "30 9 * * *"
    },
    {
      "path": "/api/cron/apify-sales",
      "schedule": "15 7 * * *"
    },
    {
      "path": "/api/cron/exchange-rates",
      "schedule": "0 18 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    }
  ]
}
